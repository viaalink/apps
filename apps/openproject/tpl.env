OPENPROJECT_PORT=getRandomPort()
OPENPROJECT_VERSION=17.9.8
OPENPROJECT_POSTGRES_VERSION=17-alpine
OPENPROJECT_MEMCACHED_VERSION=1.6-alpine
OPENPROJECT_POSTGRES_PASSWORD=getRandomString(length=32)
OPENPROJECT_POSTGRES_USER=openproject
OPENPROJECT_POSTGRES_DB=openproject
OPENPROJECT_SECRET_KEY=getRandomString(length=64)
# First administrator (login "admin"), made at the first start
OPENPROJECT_ADMIN_EMAIL=admin@example.com
OPENPROJECT_ADMIN_PASSWORD=getRandomString(length=24)
# Who may make an account for themselves: 0 nobody, 2 after the administrator's approval, 3 anyone
OPENPROJECT_SELF_REGISTRATION=0
# Address OpenProject is served on (written at every start: the published one, else this machine)
OPENPROJECT_HOST_NAME=
OPENPROJECT_HTTPS=
# Optional: a mail server. Set OPENPROJECT_MAIL_DELIVERY=smtp and fill in the rest.
OPENPROJECT_MAIL_DELIVERY=
OPENPROJECT_SMTP_ADDRESS=
OPENPROJECT_SMTP_PORT=
OPENPROJECT_SMTP_USER=
OPENPROJECT_SMTP_PASSWORD=
OPENPROJECT_MAIL_FROM=
# Container names, for scripts that talk to OpenProject's containers
OPENPROJECT_CONTAINER_NAME=${CONTAINER_PREFIX}openproject
OPENPROJECT_POSTGRES_CONTAINER=${CONTAINER_PREFIX}openproject-postgres
