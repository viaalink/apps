VAULTWARDEN_PORT=getRandomPort()
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.4
VAULTWARDEN_CONTAINER_NAME=${CONTAINER_PREFIX}vaultwarden
# Sign-in through Authentik (filled in by the prepare step when Authentik runs in the project)
VAULTWARDEN_SSO_CLIENT_ID=
VAULTWARDEN_SSO_CLIENT_SECRET=
VAULTWARDEN_SSO_AUTHORITY=
# true: Authentik is the only way in (Vaultwarden's own login off)
VAULTWARDEN_SSO_ONLY=false
# true: anyone who reaches the page can make an account with an e-mail address and a password
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_ORG_CREATORS=none
VAULTWARDEN_SMTP_FROM=${MAIL_DEFAULT_FROM}
VAULTWARDEN_SMTP_PASSWORD=
# The first person, invited by the setup step; they register with a master password of their own.
# Not needed with Authentik in the project: a first sign-in there makes the account.
VAULTWARDEN_FIRST_USER_EMAIL=
# The admin page's token (page: /admin). Made by the prepare step when the app's secrets.env has none.
VAULTWARDEN_ADMIN_TOKEN_PLAIN=
