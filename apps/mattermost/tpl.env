MATTERMOST_IMAGE=mattermost-team-edition
MATTERMOST_IMAGE_TAG=10.1
MATTERMOST_PORT=getRandomPort()
MATTERMOST_CALLS_PORT=getRandomPort()
MATTERMOST_POSTGRES_PASSWORD=getRandomString(length=32)
MATTERMOST_POSTGRES_USER=mmuser
MATTERMOST_POSTGRES_DB=mattermost
MATTERMOST_CONTAINER_NAME=${CONTAINER_PREFIX}mattermost
MATTERMOST_POSTGRES_CONTAINER=${CONTAINER_PREFIX}mattermost-postgres
MATTERMOST_OAUTH_CLIENT_ID=
MATTERMOST_OAUTH_CLIENT_SECRET=
MATTERMOST_POSTGRES_VERSION=15-alpine
MATTERMOST_ADMIN_EMAIL=admin@example.com
MATTERMOST_ADMIN_USERNAME=admin
MATTERMOST_ADMIN_PASSWORD=getRandomString(length=24)
