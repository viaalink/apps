MAUTIC_PORT=getRandomPort()
MAUTIC_VERSION=6.0.10
MAUTIC_MARIADB_VERSION=10.11
MAUTIC_MYSQL_ROOT_PASSWORD=getRandomString(length=32)
MAUTIC_MYSQL_PASSWORD=getRandomString(length=32)
MAUTIC_MYSQL_USER=mautic
MAUTIC_MYSQL_DATABASE=mautic
MAUTIC_ADMIN_EMAIL=admin@example.com
MAUTIC_ADMIN_PASSWORD=getRandomString(length=16)
MAUTIC_CONTAINER_NAME=${CONTAINER_PREFIX}mautic
MAUTIC_MYSQL_CONTAINER=${CONTAINER_PREFIX}mautic-mysql
MAUTIC_CRON_CONTAINER=${CONTAINER_PREFIX}mautic-cron
MAUTIC_WORKER_CONTAINER=${CONTAINER_PREFIX}mautic-worker
