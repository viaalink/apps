ESPOCRM_PORT=getRandomPort()
ESPOCRM_VERSION=10.1.4
ESPOCRM_MARIADB_VERSION=11.8
ESPOCRM_MARIADB_ROOT_PASSWORD=getRandomString(length=32)
ESPOCRM_MARIADB_PASSWORD=getRandomString(length=32)
ESPOCRM_MARIADB_USER=espocrm
ESPOCRM_MARIADB_DATABASE=espocrm
# First administrator, made by the first start
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=getRandomString(length=24)
# Sign-in through Authentik (filled in by the setup step when Authentik runs in the project)
ESPOCRM_OAUTH_CLIENT_ID=
ESPOCRM_OAUTH_CLIENT_SECRET=
# Container names, for scripts that talk to EspoCRM's containers
ESPOCRM_CONTAINER_NAME=${CONTAINER_PREFIX}espocrm
ESPOCRM_MARIADB_CONTAINER=${CONTAINER_PREFIX}espocrm-mariadb
ESPOCRM_DAEMON_CONTAINER=${CONTAINER_PREFIX}espocrm-daemon
