S3_PORT=getRandomPort()
S3_CONSOLE_PORT=getRandomPort()
# MinIO as built by Chainguard: the image MinIO published itself (minio/minio) can no longer
# be pulled. Chainguard gives this image out as `latest` only, so one build is named by its
# digest (2026-11-26, MinIO RELEASE.2026-11-23).
S3_IMAGE=cgr.dev/chainguard/minio@sha256:b9b1cce81a4a6cc9bf250e68d621cc0b9fb8ed15aefe18fcd1840525eab6a81a
S3_REGION=us-east-1
# The key for the vault: it reads, writes and lists the vault's bucket and nothing else.
# `via vault` looks for exactly these two names.
S3_ACCESS_KEY_ID=getRandomString(length=20)
S3_SECRET_ACCESS_KEY=getRandomString(length=40)
S3_VAULT_BUCKET=vault
# The administrator's key: all buckets, all settings, and the login of the web console.
S3_ADMIN_ACCESS_KEY_ID=getRandomString(length=20)
S3_ADMIN_SECRET_ACCESS_KEY=getRandomString(length=40)
# Sign-in through Authentik (filled in by the prepare step when Authentik runs in the project).
# Whoever trades an Authentik sign-in for temporary keys gets a folder of their own in this bucket.
S3_OAUTH_CLIENT_ID=
S3_OAUTH_CLIENT_SECRET=
S3_PEOPLE_BUCKET=people
# Container name, for scripts that talk to the storage
S3_CONTAINER_NAME=${CONTAINER_PREFIX}s3
