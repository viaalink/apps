ERPNEXT_PORT=getRandomPort()
ERPNEXT_API_URL=http://localhost:${ERPNEXT_PORT}
ERPNEXT_VERSION=v15.127.0
ERPNEXT_MARIADB_ROOT_PASSWORD=getRandomString(length=32)
ERPNEXT_MARIADB_PASSWORD=getRandomString(length=32)
ERPNEXT_MARIADB_USER=erpnext
ERPNEXT_MARIADB_DATABASE=erpnext
ERPNEXT_ADMIN_PASSWORD=getRandomString(length=16)
ERPNEXT_SITE_NAME=erpnext.localhost
ERPNEXT_CONTAINER_NAME=${CONTAINER_PREFIX}erpnext
ERPNEXT_MARIADB_CONTAINER=${CONTAINER_PREFIX}erpnext-mariadb
ERPNEXT_REDIS_CACHE_CONTAINER=${CONTAINER_PREFIX}erpnext-redis-cache
ERPNEXT_REDIS_QUEUE_CONTAINER=${CONTAINER_PREFIX}erpnext-redis-queue
ERPNEXT_OAUTH_CLIENT_ID=
ERPNEXT_OAUTH_CLIENT_SECRET=
ERPNEXT_MARIADB_VERSION=10.6
ERPNEXT_REDIS_VERSION=7-alpine
