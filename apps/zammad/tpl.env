ZAMMAD_PORT=getRandomPort()
ZAMMAD_API_URL=http://localhost:${ZAMMAD_PORT}
ZAMMAD_IMAGE=zammad/zammad:7.0.0-15
ZAMMAD_POSTGRES_USER=zammad
ZAMMAD_POSTGRES_PASSWORD=getRandomString(length=32)
ZAMMAD_POSTGRES_DB=zammad_production
ZAMMAD_CONTAINER_NAME=${CONTAINER_PREFIX}zammad
ZAMMAD_POSTGRES_CONTAINER=${CONTAINER_PREFIX}zammad-postgres
ZAMMAD_REDIS_CONTAINER=${CONTAINER_PREFIX}zammad-redis
ZAMMAD_MEMCACHED_CONTAINER=${CONTAINER_PREFIX}zammad-memcached
ZAMMAD_MEMCACHED_VERSION=1.6-alpine
ZAMMAD_POSTGRES_VERSION=17-alpine
ZAMMAD_REDIS_VERSION=7-alpine
ZAMMAD_ADMIN_EMAIL=admin@example.com
ZAMMAD_ADMIN_PASSWORD=getRandomString(length=24)
