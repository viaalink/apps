N8N_PORT=getRandomPort()
N8N_CONTAINER_PORT=5678
N8N_API_URL=http://localhost:${N8N_PORT}
N8N_IMAGE=n8nio/n8n:2.9.4
N8N_TIMEZONE=UTC
N8N_UID=1000
N8N_GID=1000
N8N_CONTAINER_NAME=${CONTAINER_PREFIX}n8n
N8N_WATCHDOG_CONTAINER_NAME=${CONTAINER_PREFIX}n8n-watchdog
N8N_POSTGRES_CONTAINER_NAME=${CONTAINER_PREFIX}n8n-postgres
N8N_POSTGRES_VERSION=15-alpine
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_PASSWORD=getRandomString(length=32)
N8N_OAUTH_CLIENT_ID=
N8N_OAUTH_CLIENT_SECRET=
N8N_ADMIN_EMAIL=admin@example.com
N8N_ADMIN_PASSWORD=getRandomString(length=24)
