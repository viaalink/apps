POSTAL_PORT=getRandomPort()
POSTAL_VERSION=3.3.4
POSTAL_MARIADB_PASSWORD=getRandomString(length=32)
POSTAL_RABBITMQ_PASSWORD=getRandomString(length=32)
POSTAL_SECRET_KEY=getRandomString(length=64)
# First administrator, made by the setup step
POSTAL_ADMIN_EMAIL=admin@example.com
POSTAL_ADMIN_PASSWORD=getRandomString(length=24)
# Sign-in through Authentik (filled in by the prepare step when Authentik runs in the project)
POSTAL_OAUTH_CLIENT_ID=
POSTAL_OAUTH_CLIENT_SECRET=
# Optional: send all outgoing mail through this relay, e.g. smtp://mail.example.com:25?ssl_mode=None
POSTAL_SMTP_RELAY=
# Container names, for scripts that talk to Postal's containers
POSTAL_CONTAINER_NAME=${CONTAINER_PREFIX}postal-web
POSTAL_MARIADB_CONTAINER=${CONTAINER_PREFIX}postal-mariadb
POSTAL_RABBITMQ_CONTAINER=${CONTAINER_PREFIX}postal-rabbitmq
POSTAL_SMTP_CONTAINER=${CONTAINER_PREFIX}postal-smtp
POSTAL_WORKER_CONTAINER=${CONTAINER_PREFIX}postal-worker
