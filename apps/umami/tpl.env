UMAMI_PORT=getRandomPort()
UMAMI_VERSION=3.5.0
UMAMI_DB_PASSWORD=getRandomString(length=32)
UMAMI_APP_SECRET=getRandomString(length=64)
UMAMI_ADMIN_PASSWORD=getRandomString(length=20)
UMAMI_CONTAINER_NAME=${CONTAINER_PREFIX}umami
UMAMI_POSTGRES_CONTAINER=${CONTAINER_PREFIX}umami-db
UMAMI_POSTGRES_VERSION=15-alpine
