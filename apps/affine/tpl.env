AFFINE_PORT=getRandomPort()
AFFINE_VERSION=0.26.4
AFFINE_REDIS_VERSION=8-alpine
AFFINE_POSTGRES_VERSION=pg16
AFFINE_POSTGRES_PASSWORD=getRandomString(length=32)
AFFINE_POSTGRES_USER=affine
AFFINE_POSTGRES_DB=affine
# First administrator, made by the setup step
AFFINE_ADMIN_EMAIL=admin@example.com
AFFINE_ADMIN_PASSWORD=getRandomString(length=24)
# Sign-in through Authentik (filled in by the setup step when Authentik runs in the project)
AFFINE_OAUTH_CLIENT_ID=
AFFINE_OAUTH_CLIENT_SECRET=
# Optional: a mail server for invitations and password mails
AFFINE_MAILER_HOST=
AFFINE_MAILER_PORT=
AFFINE_MAILER_USER=
AFFINE_MAILER_PASSWORD=
AFFINE_MAILER_SENDER=
# Container names, for scripts that talk to AFFiNE's containers
AFFINE_CONTAINER_NAME=${CONTAINER_PREFIX}affine
AFFINE_POSTGRES_CONTAINER=${CONTAINER_PREFIX}affine-postgres
AFFINE_REDIS_CONTAINER=${CONTAINER_PREFIX}affine-redis
