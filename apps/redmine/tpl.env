REDMINE_CONTAINER_NAME=${CONTAINER_PREFIX}redmine
REDMINE_POSTGRES_CONTAINER=${CONTAINER_PREFIX}redmine-postgres
REDMINE_OAUTH_CLIENT_ID=
REDMINE_OAUTH_CLIENT_SECRET=
REDMINE_POSTGRES_VERSION=15-alpine
REDMINE_VERSION=6.1
REDMINE_ADMIN_PASSWORD=getRandomString(length=24)
