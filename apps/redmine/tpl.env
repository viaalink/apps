REDMINE_PORT=getRandomPort()
REDMINE_API_URL=http://localhost:${REDMINE_PORT}
REDMINE_IMAGE=redmine-sso:6.1
REDMINE_POSTGRES_PASSWORD=getRandomString(length=32)
