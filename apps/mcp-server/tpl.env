MCP_SERVER_PORT=getRandomPort()
# The address the port listens on: this machine only. 0.0.0.0 lets other machines on the network reach it directly.
MCP_SERVER_BIND=127.0.0.1
MCP_SERVER_IMAGE=mcp-server:1.8.0
MCP_SERVER_CONTAINER_NAME=${CONTAINER_PREFIX}mcp-server
# The project's own key: a client sends it as "Authorization: Bearer <key>".
MCP_SERVER_API_KEY=getRandomString(length=48)
# More keys, separated by commas (one per client that cannot sign in).
MCP_SERVER_EXTRA_API_KEYS=
# Signs the personal keys people get after signing in through Authentik.
MCP_SERVER_SIGNING_SECRET=getRandomString(length=64)
# Sign-in through Authentik (filled in by the prepare step when Authentik runs in the project)
MCP_SERVER_OAUTH_CLIENT_ID=
MCP_SERVER_OAUTH_CLIENT_SECRET=
MCP_SERVER_AUTHENTIK_URL=
# Where the server reaches the apps of this project (filled in by the prepare step for the
# apps that are installed). An app's tools are listed only when its address and key are there.
MCP_SERVER_REDMINE_URL=
MCP_SERVER_N8N_URL=
MCP_SERVER_ZAMMAD_URL=
# Opt-in: a project folder with a Justfile, mounted read-only. Its recipes become tools
# (package_*, command_*, email_*). Empty: those tools are not listed.
MCP_SERVER_PROJECT_DIR=
# Opt-in: the Docker socket (usually /var/run/docker.sock). A proxy next to the server lets
# through container list, inspect and logs and nothing else; service_* and ecosystem_health
# become tools. Empty: no access to Docker and those tools are not listed.
MCP_SERVER_DOCKER_SOCKET=
MCP_SERVER_DOCKER_PROXY_IMAGE=wollomatic/socket-proxy:1.14.0
